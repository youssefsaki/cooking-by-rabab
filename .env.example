# Local-only. Copy values into .env.local (never commit secrets).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets mirror (required for Rabab to see bookings in her spreadsheet)
# Deploy supabase/sheets-apps-script.js as a Web App, then paste the /exec URL here:
SHEETS_WEBAPP_URL=

# Legacy alias still supported by the mirror:
# BOOKING_SCRIPT_URL=
